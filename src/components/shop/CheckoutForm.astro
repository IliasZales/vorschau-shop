---
---

<form id="checkout-form" class="space-y-6">
  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label for="firstName" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        Vorname
      </label>
      <input
        type="text"
        id="firstName"
        name="firstName"
        required
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
    <div>
      <label for="lastName" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        Nachname
      </label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        required
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="email" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
      E-Mail
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
    />
  </div>

  <div>
    <label for="street" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
      Straße & Hausnummer
    </label>
    <input
      type="text"
      id="street"
      name="street"
      required
      class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
    />
  </div>

  <div class="grid gap-6 md:grid-cols-[120px_1fr]">
    <div>
      <label for="zip" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        PLZ
      </label>
      <input
        type="text"
        id="zip"
        name="zip"
        required
        pattern="[0-9]{5}"
        inputmode="numeric"
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
    <div>
      <label for="city" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        Ort
      </label>
      <input
        type="text"
        id="city"
        name="city"
        required
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
  </div>

  <fieldset class="space-y-3">
    <legend class="mb-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
      Zahlungsmethode
    </legend>
    <label class="flex cursor-pointer items-center gap-3 border border-[var(--color-border)] bg-[var(--color-bg)] p-4 transition has-[:checked]:border-[var(--color-accent)]">
      <input type="radio" name="payment" value="card" checked class="h-4 w-4 accent-[var(--color-accent)]" />
      <span class="text-sm font-medium text-[var(--color-text)]">Kreditkarte</span>
    </label>
    <label class="flex cursor-pointer items-center gap-3 border border-[var(--color-border)] bg-[var(--color-bg)] p-4 transition has-[:checked]:border-[var(--color-accent)]">
      <input type="radio" name="payment" value="paypal" class="h-4 w-4 accent-[var(--color-accent)]" />
      <span class="text-sm font-medium text-[var(--color-text)]">PayPal</span>
    </label>
    <label class="flex cursor-pointer items-center gap-3 border border-[var(--color-border)] bg-[var(--color-bg)] p-4 transition has-[:checked]:border-[var(--color-accent)]">
      <input type="radio" name="payment" value="klarna" class="h-4 w-4 accent-[var(--color-accent)]" />
      <span class="text-sm font-medium text-[var(--color-text)]">Klarna</span>
    </label>
  </fieldset>

  <button
    type="submit"
    id="checkout-submit"
    class="inline-flex w-full items-center justify-center bg-[var(--color-text)] px-8 py-4 text-sm font-medium uppercase tracking-wider text-white transition hover:bg-[var(--color-accent)]"
  >
    Jetzt bestellen
  </button>

  <p id="checkout-error" class="hidden text-sm text-red-600" role="alert">
    Bitte fülle alle Pflichtfelder aus.
  </p>
</form>
