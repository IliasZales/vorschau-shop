---
import { shopConfig } from "../../data/shopConfig";

const { email, password } = shopConfig.testAccount;
---

<div class="border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-8">
  <h2 class="mb-2 font-display text-xl font-medium text-[var(--color-text)]">
    Test-Account
  </h2>
  <p class="mb-6 text-sm text-[var(--color-text-muted)]">
    Melde dich mit den Demo-Daten an, um den Checkout als Kunde zu erleben.
  </p>

  <form id="test-login-form" class="space-y-4">
    <div>
      <label for="test-email" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        E-Mail
      </label>
      <input
        type="email"
        id="test-email"
        value={email}
        readonly
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-2.5 text-sm text-[var(--color-text)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
    <div>
      <label for="test-password" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        Passwort
      </label>
      <input
        type="password"
        id="test-password"
        placeholder="Passwort"
        class="w-full border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-2.5 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none"
      />
    </div>
    <button
      type="submit"
      class="inline-flex w-full items-center justify-center border border-[var(--color-text)] px-6 py-3 text-sm font-medium uppercase tracking-wider text-[var(--color-text)] transition hover:bg-[var(--color-text)] hover:text-white"
    >
      Als Demo-Kunde anmelden
    </button>
    <p id="test-login-error" class="hidden text-sm text-red-600" role="alert">
      Falsches Passwort. Bitte versuche es erneut.
    </p>
  </form>

  <div id="test-login-success" class="hidden">
    <p class="flex items-center gap-2 text-sm font-medium text-green-700">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
      </svg>
      Angemeldet als Demo-Kunde
    </p>
  </div>
</div>

<script>
  import { shopConfig } from "../../data/shopConfig";

  (function () {
    const form = document.getElementById("test-login-form");
    const passwordInput = document.getElementById("test-password") as HTMLInputElement | null;
    const error = document.getElementById("test-login-error");
    const success = document.getElementById("test-login-success");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (passwordInput?.value.trim() === shopConfig.testAccount.password) {
        form.classList.add("hidden");
        success?.classList.remove("hidden");
      } else {
        error?.classList.remove("hidden");
        passwordInput?.focus();
      }
    });
  })();
</script>
