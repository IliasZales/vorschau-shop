---
import { shopConfig } from "../../data/shopConfig";

const { password } = shopConfig;
---

<div
  id="shop-password-gate"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-[var(--color-bg)] px-6"
  data-password={password}
>
  <div class="w-full max-w-md space-y-8 text-center">
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent)]">
        Geschützte Vorschau
      </p>
      <h1 class="font-display text-4xl font-medium text-[var(--color-text)] md:text-5xl">
        Shop-Vorschau
      </h1>
      <p class="mx-auto max-w-sm text-sm leading-relaxed text-[var(--color-text-muted)]">
        Dieser Bereich ist passwortgeschützt. Bitte gib das Passwort ein, um den Beispiel-Shop zu erkunden.
      </p>
    </div>

    <form id="password-form" class="space-y-4">
      <div class="relative">
        <label for="shop-password" class="sr-only">Passwort</label>
        <input
          type="password"
          id="shop-password"
          name="shop-password"
          required
          autocomplete="off"
          placeholder="Passwort eingeben"
          class="w-full appearance-none rounded-none border-b-2 border-[var(--color-border)] bg-transparent px-0 py-3 text-center text-lg text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="inline-flex w-full items-center justify-center bg-[var(--color-text)] px-8 py-3.5 text-sm font-medium uppercase tracking-wider text-white transition hover:bg-[var(--color-accent)]"
      >
        Shop öffnen
      </button>
      <p id="password-error" class="hidden text-sm text-red-600" role="alert">
        Falsches Passwort. Bitte versuche es erneut.
      </p>
    </form>

    <p class="text-xs text-[var(--color-text-muted)]">
      Demo-Passwort: <span class="font-medium text-[var(--color-text)]">{password}</span>
    </p>
  </div>
</div>

<script>
  (function () {
    const gate = document.getElementById("shop-password-gate");
    const form = document.getElementById("password-form");
    const input = document.getElementById("shop-password") as HTMLInputElement | null;
    const error = document.getElementById("password-error");

    if (!gate || !form || !input || !error) return;

    const STORAGE_KEY = "izShopAccess";
    const password = gate.dataset.password;

    // Already unlocked this session
    if (sessionStorage.getItem(STORAGE_KEY) === "granted") {
      gate.remove();
      document.body.classList.remove("overflow-hidden");
      return;
    }

    document.body.classList.add("overflow-hidden");

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (input.value.trim() === password) {
        sessionStorage.setItem(STORAGE_KEY, "granted");
        gate.classList.add("opacity-0", "transition-opacity", "duration-500");
        document.body.classList.remove("overflow-hidden");
        setTimeout(() => gate.remove(), 500);
      } else {
        error.classList.remove("hidden");
        input.value = "";
        input.focus();
      }
    });
  })();
</script>
