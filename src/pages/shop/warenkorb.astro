---
import ShopLayout from "../../layouts/ShopLayout.astro";
import CartSummary from "../../components/shop/CartSummary.astro";
import { products, formatPrice } from "../../data/products";
import { shopConfig } from "../../data/shopConfig";

const product = products[0];
const currency = product.currency;
---

<ShopLayout
  title="Warenkorb | iZ Shop-Vorschau"
  description="Dein Warenkorb im iZ Shop-Vorschau."
>
  <div class="px-6 pt-12 pb-20 lg:px-8 lg:pt-16 lg:pb-28">
    <div class="mx-auto max-w-7xl">
      <h1 class="mb-10 font-display text-4xl font-medium text-[var(--color-text)] md:text-5xl">
        Warenkorb
      </h1>

      <div class="grid gap-12 lg:grid-cols-[1fr_380px]">
        <div>
          <div id="cart-items" class="divide-y divide-[var(--color-border)] border-t border-[var(--color-border)]">
            {/* Client-side rendered */}
          </div>

          <div id="cart-empty" class="hidden py-20 text-center">
            <p class="font-display text-2xl font-medium text-[var(--color-text)]">
              Dein Warenkorb ist leer.
            </p>
            <p class="mt-2 text-[var(--color-text-muted)]">
              Entdecke unser Beispielprodukt und füge es hinzu.
            </p>
            <a
              href={`/shop/produkt/${product.slug}`}
              class="mt-8 inline-flex items-center justify-center bg-[var(--color-text)] px-8 py-4 text-sm font-medium uppercase tracking-wider text-white transition hover:bg-[var(--color-accent)]"
            >
              Zum Produkt
            </a>
          </div>
        </div>

        <aside class="h-fit">
          <CartSummary
            subtotal={0}
            shipping={shopConfig.currency === "EUR" ? 5.9 : 0}
            currency={currency}
            buttonHref="/shop/checkout"
            buttonText="Zur Kasse"
          />
        </aside>
      </div>
    </div>
  </div>
</ShopLayout>

<script>
  import { getCart, updateQuantity, removeFromCart, getCartTotal, dispatchCartUpdate } from "../../lib/cart";
  import type { CartItem } from "../../data/shopTypes";

  (function () {
    const container = document.getElementById("cart-items");
    const emptyState = document.getElementById("cart-empty");
    const summary = document.querySelector("aside [data-cart-summary]");

    function formatPrice(price: number, currency: string): string {
      return new Intl.NumberFormat("de-DE", {
        style: "currency",
        currency,
      }).format(price);
    }

    function render() {
      const cart = getCart();

      if (cart.length === 0) {
        if (container) container.innerHTML = "";
        if (emptyState) emptyState.classList.remove("hidden");
        updateSummary(0);
        return;
      }

      if (emptyState) emptyState.classList.add("hidden");
      if (container) {
        container.innerHTML = cart
          .map(
            (item) => `
          <li class="cart-item flex gap-5 py-6" data-id="${item.id}">
            <a href="/shop/produkt/${item.slug}" class="h-24 w-24 flex-shrink-0 overflow-hidden bg-[var(--color-bg)]">
              <img src="${item.image}" alt="${item.name}" class="h-full w-full object-cover" loading="lazy" />
            </a>
            <div class="flex flex-1 flex-col justify-between">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <a href="/shop/produkt/${item.slug}" class="font-display text-lg font-medium text-[var(--color-text)] transition hover:text-[var(--color-accent)]">
                    ${item.name}
                  </a>
                  <p class="text-sm text-[var(--color-text-muted)]">${formatPrice(item.price, item.currency)}</p>
                </div>
                <button type="button" class="remove-item text-sm text-[var(--color-text-muted)] underline decoration-[var(--color-border)] underline-offset-4 transition hover:text-red-600" aria-label="${item.name} entfernen">
                  Entfernen
                </button>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center border border-[var(--color-border)] bg-[var(--color-surface)]">
                  <button type="button" class="quantity-decrease px-3 py-2 text-[var(--color-text-muted)] transition hover:text-[var(--color-text)]" aria-label="Menge verringern">−</button>
                  <span class="quantity-display min-w-[2rem] select-none text-center text-sm font-medium text-[var(--color-text)]">${item.quantity}</span>
                  <button type="button" class="quantity-increase px-3 py-2 text-[var(--color-text-muted)] transition hover:text-[var(--color-text)]" aria-label="Menge erhöhen">+</button>
                </div>
                <p class="item-total text-base font-medium text-[var(--color-text)]">${formatPrice(item.price * item.quantity, item.currency)}</p>
              </div>
            </div>
          </li>
        `
          )
          .join("");
      }

      updateSummary(getCartTotal());

      document.querySelectorAll<HTMLElement>(".cart-item").forEach((item) => {
        const id = item.dataset.id;
        if (!id) return;
        const display = item.querySelector<HTMLSpanElement>(".quantity-display");

        item.querySelector<HTMLButtonElement>(".quantity-decrease")?.addEventListener("click", () => {
          const quantity = Math.max(0, Number(display?.textContent || 1) - 1);
          updateQuantity(id, quantity);
        });

        item.querySelector<HTMLButtonElement>(".quantity-increase")?.addEventListener("click", () => {
          const quantity = Number(display?.textContent || 1) + 1;
          updateQuantity(id, quantity);
        });

        item.querySelector<HTMLButtonElement>(".remove-item")?.addEventListener("click", () => {
          removeFromCart(id);
        });
      });
    }

    function updateSummary(subtotal: number) {
      const shipping = 5.9;
      const total = subtotal + shipping;

      const subtotalEl = document.getElementById("summary-subtotal");
      const totalEl = document.getElementById("summary-total");
      if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal, "EUR");
      if (totalEl) totalEl.textContent = formatPrice(total, "EUR");
    }

    render();
    window.addEventListener("cart:updated", render);
  })();
</script>
