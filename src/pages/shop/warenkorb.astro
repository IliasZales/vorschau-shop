---
import ShopLayout from "../../layouts/ShopLayout.astro";
import CartSummary from "../../components/shop/CartSummary.astro";
import { products } from "../../data/products";
import { shopConfig } from "../../data/shopConfig";

const product = products[0];
---

<ShopLayout
  title="Warenkorb | iZ Shop-Vorschau"
  description="Dein Warenkorb im iZ Shop-Vorschau."
>
  <div class="px-6 pt-12 pb-20 lg:px-8 lg:pt-16 lg:pb-28">
    <div class="mx-auto max-w-7xl">
      <h1 class="mb-10 font-display text-4xl font-medium text-[var(--color-text)] md:text-5xl">
        Warenkorb
      </h1>

      <div class="grid gap-12 lg:grid-cols-[1fr_380px]">
        <div>
          <div id="cart-items" class="divide-y divide-[var(--color-border)] border-t border-[var(--color-border)]">
            {/* Client-side rendered */}
          </div>

          <div id="cart-empty" class="hidden py-20 text-center">
            <p class="font-display text-2xl font-medium text-[var(--color-text)]">
              Dein Warenkorb ist leer.
            </p>
            <p class="mt-2 text-[var(--color-text-muted)]">
              Entdecke unser Beispielprodukt und füge es hinzu.
            </p>
            <a
              href={`/shop/produkt/${product.slug}`}
              class="mt-8 inline-flex items-center justify-center bg-[var(--color-text)] px-8 py-4 text-sm font-medium uppercase tracking-wider text-white transition hover:bg-[var(--color-accent)]"
            >
              Zum Produkt
            </a>
          </div>
        </div>

        <aside class="h-fit">
          <CartSummary
            subtotal={0}
            shipping={shopConfig.shipping}
            currency={shopConfig.currency}
            buttonHref="/shop/checkout"
            buttonText="Zur Kasse"
          />
        </aside>
      </div>
    </div>
  </div>
</ShopLayout>

<script>
  import { getCart, updateQuantity, removeFromCart, getCartTotal, dispatchCartUpdate } from "../../lib/cart";
  import { renderCartItem, formatPrice } from "../../lib/cartItemTemplate";
  import { shopConfig } from "../../data/shopConfig";

  (function () {
    const container = document.getElementById("cart-items");
    const emptyState = document.getElementById("cart-empty");

    function updateSummary(subtotal: number) {
      const total = subtotal + shopConfig.shipping;
      const subtotalEl = document.getElementById("summary-subtotal");
      const totalEl = document.getElementById("summary-total");
      if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal, shopConfig.currency);
      if (totalEl) totalEl.textContent = formatPrice(total, shopConfig.currency);
    }

    function render() {
      const cart = getCart();

      if (cart.length === 0) {
        if (container) container.innerHTML = "";
        if (emptyState) emptyState.classList.remove("hidden");
        updateSummary(0);
        return;
      }

      if (emptyState) emptyState.classList.add("hidden");
      if (container) {
        container.innerHTML = cart.map((item) => renderCartItem(item)).join("");
      }

      updateSummary(getCartTotal());

      document.querySelectorAll<HTMLElement>(".cart-item").forEach((item) => {
        const id = item.dataset.id;
        if (!id) return;
        const display = item.querySelector<HTMLSpanElement>(".quantity-display");

        item.querySelector<HTMLButtonElement>(".quantity-decrease")?.addEventListener("click", () => {
          const quantity = Math.max(0, Number(display?.textContent || 1) - 1);
          updateQuantity(id, quantity);
        });

        item.querySelector<HTMLButtonElement>(".quantity-increase")?.addEventListener("click", () => {
          const quantity = Number(display?.textContent || 1) + 1;
          updateQuantity(id, quantity);
        });

        item.querySelector<HTMLButtonElement>(".remove-item")?.addEventListener("click", () => {
          removeFromCart(id);
        });
      });
    }

    render();
    window.addEventListener("cart:updated", render);
  })();
</script>
