---
import ShopLayout from "../../layouts/ShopLayout.astro";
import CartSummary from "../../components/shop/CartSummary.astro";
import TestAccountLogin from "../../components/shop/TestAccountLogin.astro";
import CheckoutForm from "../../components/shop/CheckoutForm.astro";
import { shopConfig } from "../../data/shopConfig";
---

<ShopLayout
  title="Checkout | iZ Shop-Vorschau"
  description="Checkout im iZ Shop-Vorschau."
>
  <div class="px-6 pt-12 pb-20 lg:px-8 lg:pt-16 lg:pb-28">
    <div class="mx-auto max-w-7xl">
      <h1 class="mb-10 font-display text-4xl font-medium text-[var(--color-text)] md:text-5xl">
        Checkout
      </h1>

      <div class="grid gap-12 lg:grid-cols-[1fr_380px]">
        <div class="space-y-10">
          <TestAccountLogin />

          <div id="empty-cart-warning" class="hidden border border-red-200 bg-red-50 p-6">
            <p class="font-medium text-red-800">Dein Warenkorb ist leer.</p>
            <p class="mt-1 text-sm text-red-700">
              Füge zuerst ein Produkt hinzu, bevor du zur Kasse gehst.
            </p>
            <a href="/shop" class="mt-4 inline-block text-sm font-medium text-red-800 underline">
              Zum Shop
            </a>
          </div>

          <div id="checkout-form-wrapper" class="border-t border-[var(--color-border)] pt-10">
            <h2 class="mb-6 font-display text-2xl font-medium text-[var(--color-text)]">
              Lieferadresse
            </h2>
            <CheckoutForm />
          </div>
        </div>

        <aside class="h-fit space-y-6">
          <CartSummary
            subtotal={0}
            shipping={shopConfig.shipping}
            currency={shopConfig.currency}
            readonly
          />
          <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">
            Dies ist eine reine Vorschau. Es wird keine echte Zahlung durchgeführt und keine Bestellung ausgelöst.
          </p>
        </aside>
      </div>
    </div>
  </div>
</ShopLayout>

<script>
  import { getCart, getCartTotal } from "../../lib/cart";
  import { formatPrice } from "../../lib/cartItemTemplate";
  import { processOrder } from "../../lib/checkout";
  import { shopConfig } from "../../data/shopConfig";

  (function () {
    const cart = getCart();
    const subtotal = getCartTotal();
    const total = subtotal + shopConfig.shipping;

    const subtotalEl = document.getElementById("summary-subtotal");
    const totalEl = document.getElementById("summary-total");
    if (subtotalEl) subtotalEl.textContent = formatPrice(subtotal, shopConfig.currency);
    if (totalEl) totalEl.textContent = formatPrice(total, shopConfig.currency);

    const emptyWarning = document.getElementById("empty-cart-warning");
    const formWrapper = document.getElementById("checkout-form-wrapper");

    if (cart.length === 0) {
      emptyWarning?.classList.remove("hidden");
      formWrapper?.classList.add("hidden");
    }

    const form = document.getElementById("checkout-form") as HTMLFormElement | null;
    const submitButton = document.getElementById("checkout-submit") as HTMLButtonElement | null;
    const error = document.getElementById("checkout-error");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (cart.length === 0) {
        window.location.href = "/shop/warenkorb";
        return;
      }

      if (!form.checkValidity()) {
        error?.classList.remove("hidden");
        form.reportValidity();
        return;
      }

      error?.classList.add("hidden");
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Wird bearbeitet...";
      }

      const formData = new FormData(form);
      processOrder(formData);
    });
  })();
</script>
