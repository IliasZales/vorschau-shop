---
import BaseLayout from "./BaseLayout.astro";
import CookieConsent from "../components/cookies/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<BaseLayout title={title} description={description} robots={robots}>
  <Navigation />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</BaseLayout>
